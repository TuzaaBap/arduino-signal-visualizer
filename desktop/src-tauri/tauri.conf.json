{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arduino Signal Visualizer",
  "version": "0.5.1",
  "identifier": "io.github.tuzaabap.arduinosignalvisualizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arduino Signal Visualizer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TUZAABAP",
    "copyright": "Copyright (c) 2026 TUZAABAP",
    "category": "DeveloperTool",
    "shortDescription": "Visualize instrumented Arduino Uno GPIO, ADC, PWM, and Serial activity.",
    "longDescription": "Arduino Signal Visualizer displays validated events from an instrumented Arduino Uno while keeping normal sketch Serial input and output available in a separate Serial Monitor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
